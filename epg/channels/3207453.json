[{"id":"filtered:3207453:1792686600","epg_id":"TrueHistoryChannel.us","title":"Experiencing Rome: A Visual Exploration of Antiquity's Greatest Empire","description":"S01 E05 \u2014 Imperial Palaces\nTouring the palaces of Rome's powerful rulers; seeing how power and culture are displayed in forms that are admired and imitated by lower social classes.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792686600","stop_timestamp":"1792688400"},{"id":"filtered:3207453:1792688400","epg_id":"TrueHistoryChannel.us","title":"Experiencing Rome: A Visual Exploration of Antiquity's Greatest Empire","description":"S01 E06 \u2014 The Roman House-Space and Decoration\nAs a stage for political, religious and social display, the houses of Roman elites celebrate Roman virtues and cultural identity; reinforcing to social equals and inferiors the influence of the inhabitants.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792688400","stop_timestamp":"1792690200"},{"id":"filtered:3207453:1792690200","epg_id":"TrueHistoryChannel.us","title":"Great Battles of the Ancient World","description":"S01 E01 \u2014 Why Study Battles? What Is War?\nGarrett G. Fagan addresses the importance of studying battles and surveys the changing scholarly approach to the subject; he concludes by looking at different definitions of warfare, particularly the operational and social-constructivist models.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792690200","stop_timestamp":"1792692000"},{"id":"filtered:3207453:1792692000","epg_id":"TrueHistoryChannel.us","title":"Great Battles of the Ancient World","description":"S01 E02 \u2014 The Problem of Warfare's Origins\nThree types of evidence shed light on the origins of warfare; human remains bearing evidence of trauma; artifacts that function primarily as weapons; fortifications or depictions of warriors painted on cave walls; their interpretations are tricky.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792692000","stop_timestamp":"1792693800"},{"id":"filtered:3207453:1792693800","epg_id":"TrueHistoryChannel.us","title":"Great Battles of the Ancient World","description":"S01 E03 \u2014 Sumer, Akkad, and Early Mesopotamian Warfare\nWritten records first become available in the historical era; evidence reconstructs the conventions and conditions of warfare among the first cities in Sumer circa the 30th century B.C.; exploring the nature of Sumerian armies and battle tactics.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792693800","stop_timestamp":"1792695600"},{"id":"filtered:3207453:1792695600","epg_id":"TrueHistoryChannel.us","title":"Great Battles of the Ancient World","description":"S01 E04 \u2014 Egyptian Warfare From the Old to New Kingdoms\nEvidence of warfare in Ancient Egypt is ambiguous, but it is much more plentiful in later periods; the pharaoh's role is increasingly that of a war leader; Egyptian warfare is transformed by the introduction of the chariot.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792695600","stop_timestamp":"1792697400"},{"id":"filtered:3207453:1792697400","epg_id":"TrueHistoryChannel.us","title":"Great Battles of the Ancient World","description":"S01 E05 \u2014 The Battles of Megiddo and Kadesh\nIn the New Kingdom of Egypt, one gets the first fully recorded battle in history, the Battle of Megiddo; covering the later Battle of Kadesh, which is attested in both Egyptian and Hittite accounts.","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792697400","stop_timestamp":"1792706400"},{"id":"filtered:3207453:1792706400","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792706400","stop_timestamp":"1792720800"},{"id":"filtered:3207453:1792720800","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792720800","stop_timestamp":"1792735200"},{"id":"filtered:3207453:1792735200","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792735200","stop_timestamp":"1792749600"},{"id":"filtered:3207453:1792749600","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792749600","stop_timestamp":"1792764000"},{"id":"filtered:3207453:1792764000","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792764000","stop_timestamp":"1792778400"},{"id":"filtered:3207453:1792778400","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792778400","stop_timestamp":"1792792800"},{"id":"filtered:3207453:1792792800","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792792800","stop_timestamp":"1792807200"},{"id":"filtered:3207453:1792807200","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timestamp":"1792807200","stop_timestamp":"1792821600"},{"id":"filtered:3207453:1792821600","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1792730946463,"start_timest