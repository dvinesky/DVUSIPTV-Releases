[{"id":"filtered:3207453:1794508200","epg_id":"TrueHistoryChannel.us","title":"Warriors, Queens, and Intellectuals: 36 Great Women Before 1400","description":"S01 E01 \u2014 Julia Disobeys Emperor Augustus\nThe experiences of Julia, the daughter of Caesar Augustus; a window into the way many pre-modern societies sought to control morality; Julia's life of thwarted potential; understanding what women had to overcome to make a mark on history.","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794508200","stop_timestamp":"1794510000"},{"id":"filtered:3207453:1794510000","epg_id":"TrueHistoryChannel.us","title":"Warriors, Queens, and Intellectuals: 36 Great Women Before 1400","description":"S01 E02 \u2014 Herodias Has John the Baptist Beheaded\nThe portrayal of the John the Baptist's death as the whim of the young femme fatale Salome; why the truth is much more complicated; the story of Salome's mother, Herodias; how Herodias's hunger for power and recognition left her exiled and forgotten.","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794510000","stop_timestamp":"1794511800"},{"id":"filtered:3207453:1794511800","epg_id":"TrueHistoryChannel.us","title":"Warriors, Queens, and Intellectuals: 36 Great Women Before 1400","description":"S01 E03 \u2014 The Trung Sisters of Vietnam Fight the Han\nChina under the Han Dynasty; how imperial expansion threatened the matriarchal culture of Vietnam; the Trung sisters; leading tribal armies against the invaders; how the Trung sisters' story has become a touchstone of Vietnamese culture.","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794511800","stop_timestamp":"1794513600"},{"id":"filtered:3207453:1794513600","epg_id":"TrueHistoryChannel.us","title":"Warriors, Queens, and Intellectuals: 36 Great Women Before 1400","description":"S01 E04 \u2014 Boudicca Attacks the Romans\nThe end of Iron Age Britain and the birth of Roman Britain; the valiant but thwarted rebellion of the Celtic warrior queen, Boudicca; how Boudicca was motivated by personal tragedy; the revival of Boudicca's legacy by Queen Victoria.","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794513600","stop_timestamp":"1794515400"},{"id":"filtered:3207453:1794515400","epg_id":"TrueHistoryChannel.us","title":"Warriors, Queens, and Intellectuals: 36 Great Women Before 1400","description":"S01 E05 \u2014 Poppaea Helps Nero Persecute Christians\nNero's reputation for excess and cruelty; how Poppaea became the wife of the mad emperor; how Poppaea's religious sympathies likely influenced Nero's persecution of Christians; a complex story of spiritual zeal and vicious cruelty.","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794515400","stop_timestamp":"1794520800"},{"id":"filtered:3207453:1794520800","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794520800","stop_timestamp":"1794535200"},{"id":"filtered:3207453:1794535200","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794535200","stop_timestamp":"1794549600"},{"id":"filtered:3207453:1794549600","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794549600","stop_timestamp":"1794564000"},{"id":"filtered:3207453:1794564000","epg_id":"TrueHistoryChannel.us","title":"True History","description":"True History","metadataSource":"external_filtered","fetchedAtMillis":1794552281097,"start_timestamp":"1794564000","stop_timestamp":"1794578400"},{"id":"filtered:3207453:1794578400","epg_id":"TrueHistoryChannel.us","title":"True Hi